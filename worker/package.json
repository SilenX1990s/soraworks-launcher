{
  "name": "soraworks-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SoraWorks backend API (Cloudflare Worker + D1 + R2)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute soraworks --local --file=./migrations/0001_init.sql",
    "db:init:remote": "wrangler d1 execute soraworks --remote --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute soraworks --local --file=./migrations/0002_seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
